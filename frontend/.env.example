# Backend API URL for production deployment (e.g., Render, Railway, VPS, or Vercel backend)
# When deploying to Vercel, set this in:
# Settings -> Environment Variables -> VITE_API_URL
#
# Examples:
# ✅ Render (Supports full WebSockets & MQTT): https://smart-energy-meter-backend.onrender.com
# ✅ Vercel Backend (HTTP REST endpoints):     https://smart-energy-meter-backend.vercel.app
# ❌ INCORRECT (Dashboard URL):               https://vercel.com/user/project
#
# If left empty in local development, it defaults to http://127.0.0.1:5000 via Vite dev proxy.
VITE_API_URL=

