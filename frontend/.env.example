# Backend API URL for production deployment (e.g., Render, Railway, VPS)
# When deploying to Vercel, set this environment variable in the Vercel Project Settings:
# Settings -> Environment Variables -> VITE_API_URL = https://your-backend-domain.com
#
# If left empty in local development, it defaults to http://127.0.0.1:5000 via Vite dev proxy.
VITE_API_URL=
